<Window x:Class="NotifyLite.Windows.FloatingIconWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NotifyLite"
        Width="48" Height="48"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Icon_MouseLeftButtonDown"
        MouseLeftButtonUp="Icon_MouseLeftButtonUp"
        Loaded="Window_Loaded">

    <Grid>
        <Border x:Name="IconBorder"
                Width="42" Height="42"
                CornerRadius="3"
                Cursor="Hand"
                Background="#2B2B2B"
                BorderBrush="#3D3D3D"
                BorderThickness="1">
            <TextBlock Text="N" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <Border x:Name="BadgeBorder"
                Width="22" Height="22"
                CornerRadius="2"
                Background="#C42B1C"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,0,0,0"
                Visibility="Collapsed">
            <TextBlock x:Name="BadgeText"
                       Text="0"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <Ellipse x:Name="AnimDot"
                 Width="8" Height="8"
                 Fill="#808080"
                 Opacity="0"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 IsHitTestVisible="False"/>
    </Grid>
</Window>
