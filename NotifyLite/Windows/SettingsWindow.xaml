<Window x:Class="NotifyLite.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NotifyLite Settings"
        Width="680" Height="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        FontSize="16"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="0" CaptionHeight="0" ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="#808080"/>
            <Setter Property="Margin" Value="0,2,0,8"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="SectionHeader">
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="ValueLabel">
            <Setter Property="Foreground" Value="#9999BB"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>
        <Style TargetType="TextBox" x:Key="ColorBox">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3D3D3D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Width" Value="70"/>
            <Setter Property="MaxLength" Value="7"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderBrush" Value="#3D3D3D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4A4A4A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#777777"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#1F1F1F" CornerRadius="4" Margin="16" Padding="32,8"
            UseLayoutRounding="True" SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="56"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Padding="0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="#1F1F1F">
                <DockPanel>
                    <TextBlock Text="NotifyLite Settings"
                               Foreground="#FFFFFF" FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center" DockPanel.Dock="Left"/>
                    <Button Content="✕" Width="28" Height="28" Background="Transparent" Foreground="#999999" BorderThickness="0" 
                            HorizontalAlignment="Right" VerticalAlignment="Center" DockPanel.Dock="Right" Cursor="Hand"
                            Click="CloseWin_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="2">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#333333"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </DockPanel>
            </Border>

            <!-- Scrollable Content -->
            <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,8,0,16" PreviewMouseWheel="UIElement_OnPreviewMouseWheel">
                <StackPanel>

                    <!-- === BANNERS === -->
                    <TextBlock Text="💬  Notifications" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                    <Border Background="#2B2B2B" CornerRadius="3" Padding="22,16" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="Show custom toast cards" Style="{StaticResource Label}" DockPanel.Dock="Left"/>
                                <ToggleButton x:Name="CustomToastsCheck" Style="{StaticResource FancyToggle}" VerticalAlignment="Center"
                                              HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                            </DockPanel>
                            <TextBlock Text="Off = Windows native banners. History is still recorded. Left-click the tray icon for history."
                                       FontSize="16" Foreground="#888888" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            <DockPanel Margin="0,12,0,0">
                                <TextBlock Text="Count unread notifications" Style="{StaticResource Label}" DockPanel.Dock="Left"/>
                                <ToggleButton x:Name="CountUnreadCheck" Style="{StaticResource FancyToggle}" VerticalAlignment="Center"
                                              HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                            </DockPanel>
                            <TextBlock Text="On = show the unread number on the tray icon. Opening history marks visible items as read."
                                       FontSize="16" Foreground="#888888" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- === FLOATING ICON === -->
                    <TextBlock Text="📌  Floating Icon" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                    <Border Background="#2B2B2B" CornerRadius="3" Padding="22,16" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="Show floating icon on screen" Style="{StaticResource Label}" DockPanel.Dock="Left"/>
                                <ToggleButton x:Name="FloatingIconCheck" Style="{StaticResource FancyToggle}" VerticalAlignment="Center"
                                              HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                            </DockPanel>
                            <TextBlock Text="Optional. History is also on left-click of the tray icon."
                                       FontSize="16" Foreground="#888888" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- === APPEARANCE === -->
                    <TextBlock Text="🎨  Appearance" Style="{StaticResource SectionHeader}"/>
                    <Border Background="#2B2B2B" CornerRadius="3" Padding="22,16" Margin="0,0,0,12">
                        <StackPanel>
                            <!-- Theme -->
                            <DockPanel>
                                <TextBlock Text="Theme" Style="{StaticResource Label}" DockPanel.Dock="Left"/>
                                <ComboBox x:Name="ThemeCombo" DockPanel.Dock="Right" Width="140" HorizontalAlignment="Right" Height="36"
                                          SelectionChanged="ThemeCombo_Changed">
                                    <ComboBoxItem Content="Dark"/>
                                    <ComboBoxItem Content="Light"/>
                                </ComboBox>
                            </DockPanel>

                            <!-- Font Family -->
                            <DockPanel>
                                <TextBlock Text="Font" Style="{StaticResource Label}" DockPanel.Dock="Left"/>
                                <ComboBox x:Name="FontCombo" DockPanel.Dock="Right" Width="140" HorizontalAlignment="Right" Height="36">
                                    <ComboBoxItem Content="Segoe UI"/>
                                    <ComboBoxItem Content="Arial"/>
                                    <ComboBoxItem Content="Consolas"/>
                                    <ComboBoxItem Content="Cascadia Code"/>
                                    <ComboBoxItem Content="Inter"/>
                                </ComboBox>
                            </DockPanel>

                            <!-- Title size -->
                            <DockPanel>
                                <TextBlock Text="Title size" Style="{StaticResource Label}" DockPanel.Dock="Left"/>
                                <TextBlock x:Name="TitleSizeLabel" Style="{StaticResource ValueLabel}" DockPanel.Dock="Right"/>
                            </DockPanel>
                            <Slider x:Name="TitleSizeSlider" Minimum="16" Maximum="28" TickFrequency="1"
                                    IsSnapToTickEnabled="True" ValueChanged="TitleSizeSlider_Changed"/>

                            <!-- Body size -->
                            <DockPanel>
                                <TextBlock Text="Body size" Style="{StaticResource Label}" DockPanel.Dock="Left"/>
                                <TextBlock x:Name="BodySizeLabel" Style="{StaticResource ValueLabel}" DockPanel.Dock="Right"/>
                            </DockPanel>
                            <Slider x:Name="BodySizeSlider" Minimum="16" Maximum="24" TickFrequency="1"
                                    IsSnapToTickEnabled="True" ValueChanged="BodySizeSlider_Changed"/>
                        </StackPanel>
                    </Border>

                    <!-- === COLORS === -->
                    <TextBlock Text="🎯  Colors" Style="{StaticResource SectionHeader}"/>
                    <Border Background="#2B2B2B" CornerRadius="3" Padding="22,16" Margin="0,0,0,12">
                        <StackPanel>
                            <!-- Title color -->
                            <DockPanel Margin="0,2,0,6">
                                <TextBlock Text="Title text" Style="{StaticResource Label}" DockPanel.Dock="Left"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                    <TextBox x:Name="TitleColorBox" Style="{StaticResource ColorBox}"
                                             TextChanged="TitleColor_Changed"/>
                                    <Border x:Name="TitleColorPreview" Width="24" Height="24" CornerRadius="4"
                                            Margin="6,0,0,0" Background="#FFFFFF"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Body color -->
                            <DockPanel Margin="0,2,0,6">
                                <TextBlock Text="Body text" Style="{StaticResource Label}" DockPanel.Dock="Left"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                    <TextBox x:Name="BodyColorBox" Style="{StaticResource ColorBox}"
                                             TextChanged="BodyColor_Changed"/>
                                    <Border x:Name="BodyColorPreview" Width="24" Height="24" CornerRadius="4"
                                            Margin="6,0,0,0" Background="#CCCCCC"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Card background color -->
                            <DockPanel Margin="0,2,0,6">
                                <TextBlock Text="Card background" Style="{StaticResource Label}" DockPanel.Dock="Left"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                    <TextBox x:Name="CardColorBox" Style="{StaticResource ColorBox}"
                                             TextChanged="CardColor_Changed"/>
                                    <Border x:Name="CardColorPreview" Width="24" Height="24" CornerRadius="4"
                                            Margin="6,0,0,0" Background="#2B2B2B"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Accent color -->
                            <DockPanel Margin="0,2,0,6">
                                <TextBlock Text="Accent (timer bar)" Style="{StaticResource Label}" DockPanel.Dock="Left"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                    <TextBox x:Name="AccentColorBox" Style="{StaticResource ColorBox}"
                                             TextChanged="AccentColor_Changed"/>
                                    <Border x:Name="AccentPreview" Width="24" Height="24" CornerRadius="4"
                                            Margin="6,0,0,0" Background="#808080"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- === CARD === -->
                    <TextBlock Text="📐  Card" Style="{StaticResource SectionHeader}"/>
                    <Border Background="#2B2B2B" CornerRadius="3" Padding="22,16" Margin="0,0,0,12">
                        <StackPanel>
                            <!-- Width -->
                            <DockPanel>
                                <TextBlock Text="Width" Style="{StaticResource Label}" DockPanel.Dock="Left"/>
                                <TextBlock x:Name="WidthLabel" Style="{StaticResource ValueLabel}" DockPanel.Dock="Right"/>
                            </DockPanel>
                            <Slider x:Name="WidthSlider" Minimum="240" Maximum="500" TickFrequency="10"
                                    IsSnapToTickEnabled="True" ValueChanged="WidthSlider_Changed"/>

                            <!-- Corner Radius -->
                            <DockPanel>
                                <TextBlock Text="Corner radius" Style="{StaticResource Label}" DockPanel.Dock="Left"/>
                                <TextBlock x:Name="RadiusLabel" Style="{StaticResource ValueLabel}" DockPanel.Dock="Right"/>
                            </DockPanel>
                            <Slider x:Name="RadiusSlider" Minimum="0" Maximum="20" TickFrequency="1"
                                    IsSnapToTickEnabled="True" ValueChanged="RadiusSlider_Changed"/>

                            <!-- Card Opacity -->
                            <DockPanel>
                                <TextBlock Text="Card opacity" Style="{StaticResource Label}" DockPanel.Dock="Left"/>
                                <TextBlock x:Name="CardOpacityLabel" Style="{StaticResource ValueLabel}" DockPanel.Dock="Right"/>
                            </DockPanel>
                            <Slider x:Name="CardOpacitySlider" Minimum="0.2" Maximum="1.0" TickFrequency="0.05"
                                    IsSnapToTickEnabled="True" ValueChanged="CardOpacitySlider_Changed"/>

                            <!-- Text Opacity -->
                            <DockPanel>
                                <TextBlock Text="Text opacity" Style="{StaticResource Label}" DockPanel.Dock="Left"/>
                                <TextBlock x:Name="TextOpacityLabel" Style="{StaticResource ValueLabel}" DockPanel.Dock="Right"/>
                            </DockPanel>
                            <Slider x:Name="TextOpacitySlider" Minimum="0.3" Maximum="1.0" TickFrequency="0.05"
                                    IsSnapToTickEnabled="True" ValueChanged="TextOpacitySlider_Changed"/>
                        </StackPanel>
                    </Border>

                    <!-- === BEHAVIOR === -->
                    <TextBlock Text="⏱️  Behavior" Style="{StaticResource SectionHeader}"/>
                    <Border Background="#2B2B2B" CornerRadius="3" Padding="22,16" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="Auto-dismiss" Style="{StaticResource Label}" DockPanel.Dock="Left"/>
                                <TextBlock x:Name="DurationLabel" Style="{StaticResource ValueLabel}" DockPanel.Dock="Right"/>
                            </DockPanel>
                            <Slider x:Name="DurationSlider" Minimum="2" Maximum="15" TickFrequency="0.5"
                                    IsSnapToTickEnabled="True" ValueChanged="DurationSlider_Changed"/>

                            <DockPanel>
                                <TextBlock Text="Max visible toasts" Style="{StaticResource Label}" DockPanel.Dock="Left"/>
                                <TextBlock x:Name="MaxToastsLabel" Style="{StaticResource ValueLabel}" DockPanel.Dock="Right"/>
                            </DockPanel>
                            <Slider x:Name="MaxToastsSlider" Minimum="1" Maximum="10" TickFrequency="1"
                                    IsSnapToTickEnabled="True" ValueChanged="MaxToastsSlider_Changed"/>

                            <DockPanel>
                                <TextBlock Text="Position" Style="{StaticResource Label}" DockPanel.Dock="Left"/>
                                <ComboBox x:Name="PositionCombo" DockPanel.Dock="Right" Width="140" HorizontalAlignment="Right" Height="36"
                                          SelectionChanged="PositionCombo_Changed">
                                    <ComboBoxItem Content="Bottom Right" Tag="BottomRight"/>
                                    <ComboBoxItem Content="Bottom Left" Tag="BottomLeft"/>
                                    <ComboBoxItem Content="Top Right" Tag="TopRight"/>
                                    <ComboBoxItem Content="Top Left" Tag="TopLeft"/>
                                    <ComboBoxItem Content="Stick to Icon" Tag="FloatingIcon"/>
                                    <ComboBoxItem Content="Custom" Tag="Custom"/>
                                </ComboBox>
                            </DockPanel>

                            <!-- Custom position X/Y (only visible when Custom selected) -->
                            <StackPanel x:Name="CustomPositionPanel" Visibility="Collapsed" Margin="0,4,0,0">
                                <DockPanel Margin="0,2,0,4">
                                    <TextBlock Text="X position" Style="{StaticResource Label}" DockPanel.Dock="Left"/>
                                    <TextBox x:Name="PosXBox" Width="70" HorizontalAlignment="Right" DockPanel.Dock="Right"
                                             Background="#333333" Foreground="#FFFFFF" BorderBrush="#3D3D3D"
                                             Padding="4,2" FontSize="16"/>
                                </DockPanel>
                                <DockPanel Margin="0,2,0,4">
                                    <TextBlock Text="Y position" Style="{StaticResource Label}" DockPanel.Dock="Left"/>
                                    <TextBox x:Name="PosYBox" Width="70" HorizontalAlignment="Right" DockPanel.Dock="Right"
                                             Background="#333333" Foreground="#FFFFFF" BorderBrush="#3D3D3D"
                                             Padding="4,2" FontSize="16"/>
                                </DockPanel>
                                <TextBlock x:Name="PositionTipText" Text="Tip: Min 0. Max X: screen width, Max Y: screen height" FontSize="16" Foreground="#888888" Margin="0,0,0,4"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>



                    <!-- === SOUND === -->
                    <TextBlock Text="🔔  Sound" Style="{StaticResource SectionHeader}"/>
                    <Border Background="#2B2B2B" CornerRadius="3" Padding="22,16" Margin="0,0,0,12">
                        <StackPanel>
                            <!-- Global sound toggle -->
                            <DockPanel>
                                <TextBlock Text="Notification sound" Style="{StaticResource Label}" DockPanel.Dock="Left"/>
                                <ToggleButton x:Name="SoundEnabledCheck" Style="{StaticResource FancyToggle}" VerticalAlignment="Center"
                                              HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                            </DockPanel>

                            <!-- Default vs Custom -->
                            <TextBlock Text="Default sound" Style="{StaticResource Label}"/>
                            <DockPanel Margin="0,2,0,6">
                                <RadioButton x:Name="DefaultSoundRadio" Content="System default"
                                             Foreground="#CCCCCC" FontSize="16" GroupName="SoundType" VerticalAlignment="Center"
                                             DockPanel.Dock="Left" Checked="SoundType_Changed"/>
                                <RadioButton x:Name="CustomSoundRadio" Content="Custom"
                                             Foreground="#CCCCCC" FontSize="16" GroupName="SoundType" VerticalAlignment="Center"
                                             DockPanel.Dock="Left" Margin="20,0,0,0" Checked="SoundType_Changed"/>
                            </DockPanel>

                            <!-- Custom sound file (visible when Custom selected) -->
                            <DockPanel x:Name="CustomSoundPanel" Margin="0,0,0,6">
                                <Button Content="Browse..." Width="100" Height="36"
                                        HorizontalAlignment="Right" DockPanel.Dock="Right"
                                        Click="BrowseSound_Click"/>
                                <TextBox x:Name="SoundFileBox" IsReadOnly="True" Margin="0,0,6,0"
                                         Background="#333333" Foreground="#FFFFFF" BorderBrush="#3D3D3D"
                                         Padding="4,2" FontSize="16"/>
                            </DockPanel>

                            <!-- Per-app sounds -->
                            <TextBlock Text="Per-app sound overrides" Style="{StaticResource Label}" Margin="0,8,0,4"/>
                            <Border Background="#252525" CornerRadius="2" Padding="8,4" MaxHeight="180">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="UIElement_OnPreviewMouseWheel">
                                    <StackPanel x:Name="AppSoundsPanel"/>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- === HISTORY === -->
                    <TextBlock Text="📋  History" Style="{StaticResource SectionHeader}"/>
                    <Border Background="#2B2B2B" CornerRadius="3" Padding="22,16" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="Max stored notifications" Style="{StaticResource Label}" DockPanel.Dock="Left"/>
                                <TextBlock x:Name="HistoryMaxLabel" Style="{StaticResource ValueLabel}" DockPanel.Dock="Right"/>
                            </DockPanel>
                            <Slider x:Name="HistoryMaxSlider" Minimum="1" Maximum="200" TickFrequency="1"
                                    IsSnapToTickEnabled="True" ValueChanged="HistoryMaxSlider_Changed"/>

                            <TextBlock Text="Per-app history limits" Style="{StaticResource Label}" Margin="0,8,0,2"/>
                            <TextBlock Text="Cap how many notifications an app keeps in history. Use the app name from toasts, or an App ID (AUMID). Max 0 hides that app from history entirely."
                                       FontSize="16" Foreground="#888888" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <Border Background="#252525" CornerRadius="2" Padding="8,4" MaxHeight="220">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="UIElement_OnPreviewMouseWheel">
                                    <StackPanel x:Name="HistoryFiltersPanel"/>
                                </ScrollViewer>
                            </Border>
                            <Button Content="Add filter" Width="120" Height="36" HorizontalAlignment="Left"
                                    Margin="0,8,0,0" Click="AddHistoryFilter_Click"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Credits" Style="{StaticResource SectionHeader}" Margin="0,8,0,6"/>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock FontSize="16" Foreground="#888888" TextWrapping="Wrap" Margin="0,0,0,6">
                            <Run Text="Source project repo: "/>
                            <Hyperlink NavigateUri="https://github.com/AfaqAhmad0/NotifyLite"
                                       RequestNavigate="RepoLink_RequestNavigate"
                                       Foreground="#A0A0A0">
                                https://github.com/AfaqAhmad0/NotifyLite
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock FontSize="16" Foreground="#888888" TextWrapping="Wrap">
                            <Run Text="This fork: "/>
                            <Hyperlink NavigateUri="https://github.com/bingud/NotifyLite"
                                       RequestNavigate="RepoLink_RequestNavigate"
                                       Foreground="#A0A0A0">
                                https://github.com/bingud/NotifyLite
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#1F1F1F" Padding="0,8,0,0">
                <DockPanel>
                    <Button Content="Reset Defaults" MinWidth="140" Height="36"
                            DockPanel.Dock="Left" Click="Reset_Click"
                            Background="#333333" Foreground="#CCCCCC" BorderBrush="#3D3D3D"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Close" MinWidth="90" Height="36"
                                Click="Cancel_Click" Margin="0,0,8,0"
                                Background="#333333" Foreground="#CCCCCC" BorderBrush="#3D3D3D"/>
                        <Button Content="Save" MinWidth="90" Height="36"
                                Click="Save_Click"
                                Background="#3D3D3D" Foreground="White" BorderBrush="#4A4A4A" FontWeight="SemiBold"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
